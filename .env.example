# ============================================================
# Lebensgeschichte: переменные окружения
# Скопируйте в .env и заполните то, что отмечено ЗАПОЛНИТЬ.
# .env нельзя коммитить (он в .gitignore).
# ============================================================

# --- Безопасность ---
# ЗАПОЛНИТЬ: длинная случайная строка. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# true: можно регистрироваться. После запуска для закрытой беты поставьте false и создавайте пользователей сами
REGISTRATION_OPEN=true
TOKEN_TTL_HOURS=720

# --- ИИ (слушатель, извлечение фактов, главы книги, комикс) ---
# ЗАПОЛНИТЬ: ключ Anthropic API. Без ключа работает mock-режим (заглушки) для проверки интерфейса
ANTHROPIC_API_KEY=
# Модель можно менять без правки кода. Проверьте актуальное имя в документации Anthropic
ANTHROPIC_MODEL=claude-sonnet-5-5
# anthropic | mock (по умолчанию: anthropic, если задан ключ, иначе mock)
# LLM_PROVIDER=

# --- Распознавание речи (STT) ---
# mock | faster_whisper | openai_compatible
STT_PROVIDER=mock
# Язык распознавания: de, ru, en ... (пусто = автоопределение)
STT_LANGUAGE=de

# faster_whisper (локально на вашем сервере, данные никуда не уходят). Нужен: INSTALL_OPTIONAL=all при сборке
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# openai_compatible (облачный API с эндпоинтом /audio/transcriptions). ЗАПОЛНИТЬ при использовании
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_API_MODEL=whisper-1

# --- Данные ---
# Хранить ли исходные аудиозаписи (true рекомендуется: это часть ценности для семьи)
STORE_AUDIO=true
MAX_AUDIO_MB=50

# --- Docker ---
# weasyprint = PDF-экспорт книги; all = + faster-whisper; none = без опциональных
INSTALL_OPTIONAL=weasyprint

# --- Кризисное сообщение (необязательно) ---
# Если пусто, используется текст по умолчанию из app/config.py. Проверьте номера для вашей страны/региона
# CRISIS_TEXT=
